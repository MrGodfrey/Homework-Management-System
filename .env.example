#
# Copy this file to .env and fill local/private values.
# Do not commit .env, backend/.env, database files, backups, or exported password CSVs.
#

# App runtime
ENV=DEV
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./classroom.db
LOCAL_STORAGE_DIR=
PUBLIC_BASE_URL=http://127.0.0.1:8000
MAX_SUBMISSION_UPLOAD_BYTES=52428800

# Tencent COS storage
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=

# TokenHub / AI grading
TENCENT_MODEL_KEY_ID=
TENCENT_MODEL_KEY_SECRET=
HOMEWORK_SUMMARY_MODEL=deepseek-v4-flash
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1/chat/completions
AI_GRADING_MAX_CHARS=50000
AI_GRADING_FILE_MAX_CHARS=12000
AI_GRADING_MAX_TOKENS=1200
AI_GRADING_TIMEOUT_SECONDS=60
AI_GRADING_DAILY_LIMIT=200
AI_GRADING_ASSIGNMENT_DAILY_LIMIT=100
AI_GRADING_FAKE_RESPONSE=

# Deployment
REMOTE_ALIAS=your-server-ssh-alias
REMOTE_PUBLIC_URL=http://your-server-host-or-domain
PROJECT_DIR=/path/to/classroom
BACKEND_DIR=
FRONTEND_DIR=
BACKEND_SERVICE=your-backend-service-name
FRONTEND_PUBLISH_DIR=/path/to/frontend-publish-dir

# Authenticated online smoke test
CLASSROOM_BASE_URL=http://your-server-host-or-domain
CLASSROOM_ADMIN_USERNAME=
CLASSROOM_ADMIN_PASSWORD=

# Local preview seed data
LOCAL_PREVIEW_ADMIN_USERNAME=local_admin
LOCAL_PREVIEW_ADMIN_PASSWORD=

# Legacy/private local helper aliases. Keep values only in .env when needed.
TENCENT_SERVER_IP=
ADMIN_USERNAME=
ADMIN_PASSWORD=
TEST_STUDENT_USERNAME=
TEST_STUDENT_PASSWORD=
